// Flyviman database schema.
// Design and conventions: ../../docs/architecture/database-design.md
// This file holds the foundation models. Each milestone adds its own models
// through a migration (see the /db-migration skill).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OPERATOR_ADMIN
  OPERATOR_STAFF
  OPS
  FINANCE_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

/// Who suspended an account: Flyviman (an administrator) or the operator the
/// staff member belongs to. Only an operator's own suspension can be lifted
/// by that operator (D-070).
enum SuspensionSource {
  PLATFORM
  OPERATOR
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  email           String?           @unique
  phone           String?           @unique
  passwordHash    String?
  role            Role              @default(CUSTOMER)
  status          UserStatus        @default(PENDING_VERIFICATION)
  /// Set while SUSPENDED; null otherwise.
  suspendedBy     SuspensionSource?
  emailVerifiedAt DateTime?         @db.Timestamptz
  phoneVerifiedAt DateTime?         @db.Timestamptz
  lastLoginAt     DateTime?         @db.Timestamptz
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz

  sessions        Session[]
  consents        Consent[]
  customerProfile CustomerProfile?
  operatorMember  OperatorMember?
  notifications   Notification[]
  storedFiles     StoredFile[]

  @@index([role, status])
}

/// One row per issued refresh token. Refresh tokens are stored hashed and rotate.
/// Every rotation of one sign-in shares a familyId; reuse of a rotated token
/// revokes the whole family.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime  @db.Timestamptz
  revokedAt        DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Append-only record of administrative and financial actions. `actorId` is
/// deliberately not a foreign key: a record must outlive the user it names
/// and can never be updated, not even to clear the reference.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actorRole  Role?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// M1. Identity
// ---------------------------------------------------------------------------

enum ConsentType {
  TERMS
  PRIVACY
  BOOKING_CONDITIONS
  MARKETING
}

/// One row per acceptance. `version` is the ContentItem.version accepted.
model Consent {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  type       ConsentType
  version    String
  acceptedAt DateTime    @default(now()) @db.Timestamptz
  ipAddress  String?
  createdAt  DateTime    @default(now()) @db.Timestamptz
  updatedAt  DateTime    @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model CustomerProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  firstName   String
  lastName    String
  dateOfBirth DateTime? @db.Date
  /// ISO 3166-1 alpha-2.
  nationality String?   @db.Char(2)
  preferences Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  passengers Passenger[]
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum IdentityDocumentType {
  PASSPORT
  AADHAAR
  DRIVING_LICENCE
  VOTER_ID
  OTHER
}

/// A traveller saved by a customer. `documentNumber` is encrypted by the
/// application (docs/architecture/security-rbac.md). Removal is a soft delete
/// because bookings will refer to passengers.
model Passenger {
  id                String                @id @default(uuid()) @db.Uuid
  customerId        String                @db.Uuid
  firstName         String
  lastName          String
  dateOfBirth       DateTime?             @db.Date
  gender            Gender                @default(UNSPECIFIED)
  nationality       String?               @db.Char(2)
  documentType      IdentityDocumentType?
  documentNumber    String?
  documentExpiry    DateTime?             @db.Date
  specialAssistance String?
  deletedAt         DateTime?             @db.Timestamptz
  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @updatedAt @db.Timestamptz

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, deletedAt])
}

// ---------------------------------------------------------------------------
// M1. Operators
// ---------------------------------------------------------------------------

enum ServiceCategory {
  SCHEDULED_AIRLINE
  PRIVATE_CHARTER
  HELICOPTER
  EMPTY_LEG
  AIR_AMBULANCE
}

/// Values and transitions: docs/architecture/state-machines.md.
enum OperatorStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model Operator {
  id                 String            @id @default(uuid()) @db.Uuid
  legalName          String
  tradingName        String?
  registrationNumber String?
  taxNumber          String?
  businessAddress    Json?
  billingAddress     Json?
  contactName        String
  contactEmail       String
  contactPhone       String?
  serviceCategories  ServiceCategory[]
  operatingRegions   String[]
  status             OperatorStatus    @default(DRAFT)
  submittedAt        DateTime?         @db.Timestamptz
  reviewedById       String?           @db.Uuid
  reviewedAt         DateTime?         @db.Timestamptz
  reviewNote         String?
  bookingMode        Json?
  paymentModel       Json?
  createdAt          DateTime          @default(now()) @db.Timestamptz
  updatedAt          DateTime          @updatedAt @db.Timestamptz

  members   OperatorMember[]
  documents OperatorDocument[]
  aircraft  Aircraft[]

  @@index([status, submittedAt])
}

/// Links an operator user to their organisation.
model OperatorMember {
  id          String   @id @default(uuid()) @db.Uuid
  operatorId  String   @db.Uuid
  userId      String   @unique @db.Uuid
  permissions Json?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

enum OperatorDocumentType {
  AOC
  INSURANCE
  REGISTRATION
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model OperatorDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  operatorId         String                     @db.Uuid
  type               OperatorDocumentType
  /// The uploaded file (documents module). Holds the storage key and name.
  fileId             String                     @unique @db.Uuid
  issuedAt           DateTime?                  @db.Date
  expiresAt          DateTime?                  @db.Date
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedById       String?                    @db.Uuid
  verifiedAt         DateTime?                  @db.Timestamptz
  verificationNote   String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz
  updatedAt          DateTime                   @updatedAt @db.Timestamptz

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, type])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// M1. Platform: files, notifications, content
// ---------------------------------------------------------------------------

enum FilePurpose {
  OPERATOR_DOCUMENT
  AIRCRAFT_PHOTO
  AIRCRAFT_FLOOR_PLAN
  AIRCRAFT_DOCUMENT
}

/// Metadata for a file in private storage. A file is usable once `uploadedAt`
/// is set, which happens when its owner attaches it to a record.
model StoredFile {
  id          String      @id @default(uuid()) @db.Uuid
  ownerId     String      @db.Uuid
  purpose     FilePurpose
  storageKey  String      @unique
  fileName    String
  contentType String
  sizeBytes   Int
  uploadedAt  DateTime?   @db.Timestamptz
  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

/// Delivery log and in-app inbox. `payload` never holds a one-time password,
/// a reset link or medical data.
model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  /// Null only for an email or SMS to a staff inbox rather than an account
  /// (the operations inbox told of a new enquiry). In-app rows always have one.
  userId            String?             @db.Uuid
  channel           NotificationChannel
  templateKey       String
  payload           Json
  status            NotificationStatus  @default(QUEUED)
  readAt            DateTime?           @db.Timestamptz
  providerMessageId String?
  /// Outbox (D-072): where a QUEUED email or SMS goes, how many delivery
  /// attempts were made and when the next one is due. Never set for
  /// messages carrying a code or link (those are sent at once, not stored).
  recipient         String?
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime?           @db.Timestamptz
  createdAt         DateTime            @default(now()) @db.Timestamptz
  updatedAt         DateTime            @updatedAt @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, createdAt])
  @@index([status, nextAttemptAt])
}

/// Which table an expiring document lives in.
enum ExpiryDocumentKind {
  OPERATOR
  AIRCRAFT
}

/// One row per expiry alert sent (M3 step 8, D-048): a document is alerted
/// once per threshold (30, 7 and 0 days) for a given expiry date, so a
/// renewed document with a new date is alerted afresh. Owned by compliance.
model DocumentExpiryAlert {
  id         String             @id @default(uuid()) @db.Uuid
  kind       ExpiryDocumentKind
  documentId String             @db.Uuid
  /// Days before expiry: 30, 7, or 0 (on or after the day).
  threshold  Int
  expiresAt  DateTime           @db.Date
  createdAt  DateTime           @default(now()) @db.Timestamptz
  updatedAt  DateTime           @updatedAt @db.Timestamptz

  @@unique([kind, documentId, threshold, expiresAt])
  @@index([documentId])
}

model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  key       String
  channel   NotificationChannel
  subject   String?
  body      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now()) @db.Timestamptz
  updatedAt DateTime            @updatedAt @db.Timestamptz

  @@unique([key, channel])
}

enum ContentKind {
  BANNER
  FAQ
  POLICY
}

// ---------------------------------------------------------------------------
// M3. Locations
// ---------------------------------------------------------------------------

enum LocationType {
  AIRPORT
  HELIPORT
  CITY
  LANDING_SITE
}

/// Used by location charges now and by Aircraft from M3 step 3.
enum AircraftCategory {
  TURBOPROP
  LIGHT_JET
  MIDSIZE_JET
  HEAVY_JET
  HELICOPTER
  AIR_AMBULANCE_FIXED
  AIR_AMBULANCE_ROTARY
}

/// Airports, heliports and landing sites. Seeded from prisma/data (OurAirports)
/// and managed by operations. `capabilities` and `charges` shapes:
/// docs/architecture/database-design.md. The name and city trigram indexes
/// need the pg_trgm extension, created in the migration.
model Location {
  id           String       @id @default(uuid()) @db.Uuid
  type         LocationType
  name         String
  iata         String?      @unique @db.Char(3)
  icao         String?      @unique @db.Char(4)
  city         String?
  state        String?
  /// ISO 3166-1 alpha-2.
  country      String       @db.Char(2)
  latitude     Float
  longitude    Float
  /// IANA time zone, for example Asia/Kolkata.
  timeZone     String
  capabilities Json
  charges      Json?
  isActive     Boolean      @default(true)
  /// Where a seeded row came from, for example `ourairports:VABB`.
  externalRef  String?      @unique
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz

  homeBasedAircraft     Aircraft[]         @relation("AircraftHomeBase")
  currentlyHereAircraft Aircraft[]         @relation("AircraftCurrentLocation")
  departureSlots        AvailabilitySlot[]

  @@index([type, isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_name_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_city_trgm_idx")
}

// ---------------------------------------------------------------------------
// M3. Aircraft
// ---------------------------------------------------------------------------

enum WingType {
  FIXED_WING
  HELICOPTER
}

enum AircraftAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

/// Values and transitions: docs/architecture/state-machines.md.
enum AircraftListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum AircraftPricingModel {
  HOURLY
  SECTOR
  FIXED_ROUTE
}

enum AircraftMediaKind {
  PHOTO
  FLOOR_PLAN
}

enum AircraftDocumentType {
  REGISTRATION
  AIRWORTHINESS
  INSURANCE
  OTHER
}

/// An aircraft profile belonging to one operator. Searchable only when
/// listingStatus is APPROVED, the operator is APPROVED, availabilityStatus is
/// AVAILABLE, and required documents are unexpired (enforced in search, M5).
model Aircraft {
  id                 String                     @id @default(uuid()) @db.Uuid
  operatorId         String                     @db.Uuid
  /// Tail number / registration mark, unique across the platform.
  registration       String                     @unique
  manufacturer       String
  model              String
  category           AircraftCategory
  wingType           WingType
  passengerCapacity  Int
  baggageCapacityKg  Int?
  rangeKm            Int?
  cruiseSpeedKmh     Int?
  homeBaseId         String?                    @db.Uuid
  currentLocationId  String?                    @db.Uuid
  operatingRegions   String[]                   @default([])
  /// Operating hours, excluded locations, minimum notice.
  restrictions       Json?
  availabilityStatus AircraftAvailabilityStatus @default(AVAILABLE)
  listingStatus      AircraftListingStatus      @default(DRAFT)
  pricingModel       AircraftPricingModel       @default(HOURLY)
  /// Free-form description and cabin notes.
  specifications     Json?
  medicalEquipment   Json?
  submittedAt        DateTime?                  @db.Timestamptz
  reviewedById       String?                    @db.Uuid
  reviewedAt         DateTime?                  @db.Timestamptz
  reviewNote         String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz
  updatedAt          DateTime                   @updatedAt @db.Timestamptz

  operator        Operator            @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  homeBase        Location?           @relation("AircraftHomeBase", fields: [homeBaseId], references: [id], onDelete: SetNull)
  currentLocation Location?           @relation("AircraftCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  media           AircraftMedia[]
  documents       AircraftDocument[]
  slots           AvailabilitySlot[]
  blocks          AvailabilityBlock[]

  @@index([operatorId, listingStatus])
  @@index([listingStatus, category, passengerCapacity])
  @@index([homeBaseId])
  @@index([currentLocationId])
}

/// Photos and floor plans. The file lives in StoredFile (D-024); `kind`
/// must match the file's purpose.
model AircraftMedia {
  id         String            @id @default(uuid()) @db.Uuid
  aircraftId String            @db.Uuid
  fileId     String            @unique @db.Uuid
  kind       AircraftMediaKind
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now()) @db.Timestamptz
  updatedAt  DateTime          @updatedAt @db.Timestamptz

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId, sortOrder])
}

model AircraftDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  aircraftId         String                     @db.Uuid
  type               AircraftDocumentType
  fileId             String                     @unique @db.Uuid
  issuedAt           DateTime?                  @db.Date
  expiresAt          DateTime?                  @db.Date
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedById       String?                    @db.Uuid
  verifiedAt         DateTime?                  @db.Timestamptz
  verificationNote   String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz
  updatedAt          DateTime                   @updatedAt @db.Timestamptz

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId, type])
  @@index([expiresAt])
}

enum AvailabilitySlotKind {
  OPEN
  DEPARTURE_SLOT
}

enum AvailabilityBlockReason {
  MAINTENANCE
  BLACKOUT
  SOFT_HOLD
  BOOKING
  OTHER
}

/// Time the aircraft is offered.
model AvailabilitySlot {
  id         String               @id @default(uuid()) @db.Uuid
  aircraftId String               @db.Uuid
  startsAt   DateTime             @db.Timestamptz
  endsAt     DateTime             @db.Timestamptz
  originId   String?              @db.Uuid
  kind       AvailabilitySlotKind
  createdAt  DateTime             @default(now()) @db.Timestamptz
  updatedAt  DateTime             @updatedAt @db.Timestamptz

  aircraft Aircraft  @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  origin   Location? @relation(fields: [originId], references: [id], onDelete: SetNull)

  @@index([aircraftId, startsAt, endsAt])
  @@index([originId])
}

/// Time the aircraft is not free. Two BOOKING blocks for one aircraft may
/// never overlap; that exclusion constraint is raw SQL in the migration.
model AvailabilityBlock {
  id         String                  @id @default(uuid()) @db.Uuid
  aircraftId String                  @db.Uuid
  startsAt   DateTime                @db.Timestamptz
  endsAt     DateTime                @db.Timestamptz
  reason     AvailabilityBlockReason
  /// Set when bookings exist (M8). No foreign key until that table ships.
  bookingId  String?                 @db.Uuid
  expiresAt  DateTime?               @db.Timestamptz
  note       String?
  createdAt  DateTime                @default(now()) @db.Timestamptz
  updatedAt  DateTime                @updatedAt @db.Timestamptz

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId, startsAt, endsAt])
  @@index([reason, expiresAt])
}

model ContentItem {
  id          String      @id @default(uuid()) @db.Uuid
  kind        ContentKind
  slug        String
  title       String
  body        String
  /// For policies: the version a Consent row records.
  version     String?
  region      String?
  sortOrder   Int         @default(0)
  publishedAt DateTime?   @db.Timestamptz
  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz

  @@unique([kind, slug])
  @@index([kind, publishedAt, sortOrder])
}

// ---------------------------------------------------------------------------
// Sales enquiries (contact page)
// ---------------------------------------------------------------------------

/// What a sales enquiry from the contact page is about.
enum EnquiryTopic {
  GENERAL
  PRIVATE_CHARTER
  CELEBRITY_CHARTER
  ELECTION_CHARTER
  MARRIAGE_CHARTER
  PILGRIMAGE_CHARTER
  MEDICAL_CHARTER
  GROUP_CHARTER
  FLOWER_DROP_CHARTER
  AIRCRAFT_SALES
  CONSULTANCY
  PILOT_JOBS
  PILOT_TRAINING
}

/// A sales enquiry sent from the public contact page. Contact details and
/// the message are personal data: never logged, never in the audit trail.
model Enquiry {
  id        String       @id @default(uuid()) @db.Uuid
  /// Human reference, for example FLY-ENQ-7K2M9Q.
  reference String       @unique
  name      String
  email     String?
  phone     String?
  topic     EnquiryTopic
  message   String
  /// When operations dealt with it (set from the admin list, M10).
  handledAt DateTime?    @db.Timestamptz
  createdAt DateTime     @default(now()) @db.Timestamptz
  updatedAt DateTime     @updatedAt @db.Timestamptz

  @@index([handledAt, createdAt])
}

// ---------------------------------------------------------------------------
// M5. Search and pricing (docs/architecture/pricing-engine.md)
// ---------------------------------------------------------------------------

enum PricingRuleScope {
  PLATFORM
  CATEGORY
  OPERATOR
  AIRCRAFT
  ROUTE
}

enum PricingRuleType {
  HOURLY_RATE
  SECTOR_RATE
  FIXED_ROUTE
  MIN_BILLABLE_HOURS
  POSITIONING
  WAITING
  OVERNIGHT
  LANDING
  HANDLING
  CREW
  FUEL_SURCHARGE
  PERMIT
  NAVIGATION
  OTHER
  COMMISSION
  MARKUP
  SERVICE_FEE
  MIN_CHARGE
  TAX
  DISCOUNT
  ROUTING_FACTOR
  /// Minutes added to each leg for taxi, departure and arrival.
  TIME_ALLOWANCE
  VALIDITY
}

/// Every price carries one (business rule 1).
enum PriceType {
  ESTIMATE
  LIVE_FARE
  QUOTE
  CONFIRMED
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
  MULTI_LEG
}

/// A pricing input. Never edited in place: a change closes this row
/// (`validTo`, `isActive`) and creates the next `version`, so past
/// calculations stay explainable. `scopeRef` is the category, operator,
/// aircraft or route the rule belongs to; null for PLATFORM.
model PricingRule {
  id          String           @id @default(uuid()) @db.Uuid
  scope       PricingRuleScope
  scopeRef    String?
  type        PricingRuleType
  config      Json
  priority    Int              @default(0)
  validFrom   DateTime         @default(now()) @db.Timestamptz
  validTo     DateTime?        @db.Timestamptz
  isActive    Boolean          @default(true)
  version     Int              @default(1)
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz

  @@index([type, scope, scopeRef, isActive])
}

/// One customer search. Doubles as the search log for reporting. `results`
/// holds the offered aircraft in order; `exclusions` why the others were
/// left out (operations only).
model Search {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String?         @db.Uuid
  category       ServiceCategory
  tripType       TripType
  legs           Json
  passengerCount Int
  preferences    Json?
  results        Json
  exclusions     Json?
  resultCount    Int
  durationMs     Int
  providerStatus Json?
  createdAt      DateTime        @default(now()) @db.Timestamptz

  calculations PriceCalculation[]

  @@index([createdAt])
}

/// An engine-generated price with everything needed to explain it.
/// Immutable once written. `operatorPayableMinor` and
/// `platformRevenueMinor` are never shown to customers.
model PriceCalculation {
  id                    String    @id @default(uuid()) @db.Uuid
  searchId              String?   @db.Uuid
  aircraftId            String    @db.Uuid
  operatorId            String    @db.Uuid
  inputs                Json
  appliedRules          Json
  breakdown             Json
  baseMinor             Int
  feesMinor             Int
  taxMinor              Int
  discountMinor         Int
  totalMinor            Int
  operatorPayableMinor  Int
  platformRevenueMinor  Int
  currency              String    @db.Char(3)
  priceType             PriceType
  validUntil            DateTime  @db.Timestamptz
  availabilityCheckedAt DateTime  @db.Timestamptz
  assumptions           Json
  exclusions            Json
  warnings              Json
  overriddenById        String?   @db.Uuid
  overrideReason        String?
  createdAt             DateTime  @default(now()) @db.Timestamptz

  search Search? @relation(fields: [searchId], references: [id], onDelete: SetNull)

  @@index([searchId])
  @@index([aircraftId, createdAt])
}
