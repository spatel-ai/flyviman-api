// Flyviman database schema.
// Design and conventions: ../../docs/architecture/database-design.md
// This file holds the foundation models. Each milestone adds its own models
// through a migration (see the /db-migration skill).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OPERATOR_ADMIN
  OPERATOR_STAFF
  OPS
  FINANCE_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

/// Who suspended an account: Flyviman (an administrator) or the operator the
/// staff member belongs to. Only an operator's own suspension can be lifted
/// by that operator (D-070).
enum SuspensionSource {
  PLATFORM
  OPERATOR
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  email           String?           @unique
  phone           String?           @unique
  passwordHash    String?
  role            Role              @default(CUSTOMER)
  status          UserStatus        @default(PENDING_VERIFICATION)
  /// Set while SUSPENDED; null otherwise.
  suspendedBy     SuspensionSource?
  emailVerifiedAt DateTime?         @db.Timestamptz
  phoneVerifiedAt DateTime?         @db.Timestamptz
  lastLoginAt     DateTime?         @db.Timestamptz
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz

  sessions             Session[]
  consents             Consent[]
  customerProfile      CustomerProfile?
  operatorMember       OperatorMember?
  notifications        Notification[]
  storedFiles          StoredFile[]
  bookings             Booking[]
  emptyLegInterests    EmptyLegInterest[]
  airAmbulanceRequests AirAmbulanceRequest[]

  @@index([role, status])
}

/// One row per issued refresh token. Refresh tokens are stored hashed and rotate.
/// Every rotation of one sign-in shares a familyId; reuse of a rotated token
/// revokes the whole family.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime  @db.Timestamptz
  revokedAt        DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Append-only record of administrative and financial actions. `actorId` is
/// deliberately not a foreign key: a record must outlive the user it names
/// and can never be updated, not even to clear the reference.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actorRole  Role?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

/// Where an idempotent request has got to (`src/common/idempotency`).
enum IdempotencyKeyStatus {
  /// The first request holds the key and is running.
  IN_PROGRESS
  /// Its changes committed (in the same transaction as this status), but
  /// the response is not stored yet.
  COMMITTED
  /// Finished; the stored response is replayed to repeats.
  COMPLETED
  /// It failed after its changes committed. Never replayed as a success
  /// and never run again under this key.
  FAILED
}

/// One `Idempotency-Key` per caller and route. The unique (scope, key) pair
/// is what stops a repeat creating a second record; the owner token fences
/// a request whose lock was taken over after it ran too long.
model IdempotencyKey {
  id             String               @id @default(uuid()) @db.Uuid
  /// The caller (user id, or `anonymous`), the method, the route template
  /// (`/api/v1/bookings/:id`) and the path parameters sorted by name.
  scope          String
  key            String               @db.Uuid
  /// HMAC-SHA256 of the request body the key was first used with, keyed by
  /// HKDF from DATA_ENCRYPTION_KEY.
  requestHash    String
  status         IdempotencyKeyStatus
  /// Changes on every claim; writes by a request that lost its claim match nothing.
  ownerToken     String               @db.Uuid
  /// A request still IN_PROGRESS after this is presumed dead and may be taken over.
  lockedUntil    DateTime             @db.Timestamptz
  responseStatus Int?
  /// The handler's result (inside the envelope), replayed to repeats.
  responseBody   Json?
  /// After this the key may be used again (24 hours, api-design.md); expired
  /// keys are purged daily.
  expiresAt      DateTime             @db.Timestamptz
  createdAt      DateTime             @default(now()) @db.Timestamptz
  updatedAt      DateTime             @updatedAt @db.Timestamptz

  @@unique([scope, key])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// M1. Identity
// ---------------------------------------------------------------------------

enum ConsentType {
  TERMS
  PRIVACY
  BOOKING_CONDITIONS
  MARKETING
}

/// One row per acceptance. `version` is the ContentItem.version accepted.
model Consent {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  type       ConsentType
  version    String
  acceptedAt DateTime    @default(now()) @db.Timestamptz
  ipAddress  String?
  createdAt  DateTime    @default(now()) @db.Timestamptz
  updatedAt  DateTime    @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model CustomerProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  firstName   String
  lastName    String
  dateOfBirth DateTime? @db.Date
  /// ISO 3166-1 alpha-2.
  nationality String?   @db.Char(2)
  preferences Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  passengers Passenger[]
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum IdentityDocumentType {
  PASSPORT
  AADHAAR
  DRIVING_LICENCE
  VOTER_ID
  OTHER
}

/// A traveller saved by a customer. `documentNumber` and `specialAssistance`
/// are encrypted by the application (docs/architecture/security-rbac.md);
/// plain-text `specialAssistance` saved earlier is encrypted when the API
/// starts (src/modules/customers/special-assistance-backfill.ts). Removal is a soft delete
/// because bookings will refer to passengers.
model Passenger {
  id                String                @id @default(uuid()) @db.Uuid
  customerId        String                @db.Uuid
  firstName         String
  lastName          String
  dateOfBirth       DateTime?             @db.Date
  gender            Gender                @default(UNSPECIFIED)
  nationality       String?               @db.Char(2)
  documentType      IdentityDocumentType?
  documentNumber    String?
  documentExpiry    DateTime?             @db.Date
  specialAssistance String?
  deletedAt         DateTime?             @db.Timestamptz
  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @updatedAt @db.Timestamptz

  customer          CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingPassengers BookingPassenger[]

  @@index([customerId, deletedAt])
}

// ---------------------------------------------------------------------------
// M1. Operators
// ---------------------------------------------------------------------------

enum ServiceCategory {
  SCHEDULED_AIRLINE
  PRIVATE_CHARTER
  HELICOPTER
  EMPTY_LEG
  AIR_AMBULANCE
}

/// Values and transitions: docs/architecture/state-machines.md.
enum OperatorStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model Operator {
  id                 String            @id @default(uuid()) @db.Uuid
  legalName          String
  tradingName        String?
  registrationNumber String?
  taxNumber          String?
  businessAddress    Json?
  billingAddress     Json?
  contactName        String
  contactEmail       String
  contactPhone       String?
  serviceCategories  ServiceCategory[]
  operatingRegions   String[]
  status             OperatorStatus    @default(DRAFT)
  submittedAt        DateTime?         @db.Timestamptz
  reviewedById       String?           @db.Uuid
  reviewedAt         DateTime?         @db.Timestamptz
  reviewNote         String?
  bookingMode        Json?
  paymentModel       Json?
  /// Operator-wide operating hours, excluded locations and minimum notice,
  /// in the shape of `Aircraft.restrictions`. Matching applies both; the
  /// stricter wins.
  restrictions       Json?
  createdAt          DateTime          @default(now()) @db.Timestamptz
  updatedAt          DateTime          @updatedAt @db.Timestamptz

  members              OperatorMember[]
  documents            OperatorDocument[]
  aircraft             Aircraft[]
  quotes               Quote[]
  bookings             Booking[]
  settlements          Settlement[]
  emptyLegs            EmptyLeg[]
  airAmbulanceRequests AirAmbulanceRequest[]

  @@index([status, submittedAt])
}

/// Links an operator user to their organisation.
model OperatorMember {
  id          String   @id @default(uuid()) @db.Uuid
  operatorId  String   @db.Uuid
  userId      String   @unique @db.Uuid
  permissions Json?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

enum OperatorDocumentType {
  AOC
  INSURANCE
  REGISTRATION
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model OperatorDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  operatorId         String                     @db.Uuid
  type               OperatorDocumentType
  /// The uploaded file (documents module). Holds the storage key and name.
  fileId             String                     @unique @db.Uuid
  issuedAt           DateTime?                  @db.Date
  expiresAt          DateTime?                  @db.Date
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedById       String?                    @db.Uuid
  verifiedAt         DateTime?                  @db.Timestamptz
  verificationNote   String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz
  updatedAt          DateTime                   @updatedAt @db.Timestamptz

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, type])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// M1. Platform: files, notifications, content
// ---------------------------------------------------------------------------

enum FilePurpose {
  OPERATOR_DOCUMENT
  AIRCRAFT_PHOTO
  AIRCRAFT_FLOOR_PLAN
  AIRCRAFT_DOCUMENT
  /// A medical document for an air ambulance request (restricted, rule 8).
  AIR_AMBULANCE_DOCUMENT
}

/// Metadata for a file in private storage. A file is usable once `uploadedAt`
/// is set, which happens when its owner attaches it to a record.
model StoredFile {
  id          String      @id @default(uuid()) @db.Uuid
  ownerId     String      @db.Uuid
  purpose     FilePurpose
  storageKey  String      @unique
  fileName    String
  contentType String
  sizeBytes   Int
  uploadedAt  DateTime?   @db.Timestamptz
  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz

  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  airAmbulanceDocument AirAmbulanceDocument?

  @@index([ownerId])
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

/// Delivery log and in-app inbox. `payload` never holds a one-time password,
/// a reset link or medical data.
model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  /// Null only for an email or SMS to a staff inbox rather than an account
  /// (the operations inbox told of a new enquiry). In-app rows always have one.
  userId            String?             @db.Uuid
  channel           NotificationChannel
  templateKey       String
  payload           Json
  status            NotificationStatus  @default(QUEUED)
  readAt            DateTime?           @db.Timestamptz
  providerMessageId String?
  /// Outbox (D-072): where a QUEUED email or SMS goes, how many delivery
  /// attempts were made and when the next one is due. Never set for
  /// messages carrying a code or link (those are sent at once, not stored).
  recipient         String?
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime?           @db.Timestamptz
  createdAt         DateTime            @default(now()) @db.Timestamptz
  updatedAt         DateTime            @updatedAt @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, createdAt])
  @@index([status, nextAttemptAt])
}

/// Which table an expiring document lives in.
enum ExpiryDocumentKind {
  OPERATOR
  AIRCRAFT
}

/// One row per expiry alert sent (M3 step 8, D-048): a document is alerted
/// once per threshold (30, 7 and 0 days) for a given expiry date, so a
/// renewed document with a new date is alerted afresh. Owned by compliance.
model DocumentExpiryAlert {
  id         String             @id @default(uuid()) @db.Uuid
  kind       ExpiryDocumentKind
  documentId String             @db.Uuid
  /// Days before expiry: 30, 7, or 0 (on or after the day).
  threshold  Int
  expiresAt  DateTime           @db.Date
  createdAt  DateTime           @default(now()) @db.Timestamptz
  updatedAt  DateTime           @updatedAt @db.Timestamptz

  @@unique([kind, documentId, threshold, expiresAt])
  @@index([documentId])
}

model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  key       String
  channel   NotificationChannel
  subject   String?
  body      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now()) @db.Timestamptz
  updatedAt DateTime            @updatedAt @db.Timestamptz

  @@unique([key, channel])
}

enum ContentKind {
  BANNER
  FAQ
  POLICY
}

// ---------------------------------------------------------------------------
// M3. Locations
// ---------------------------------------------------------------------------

enum LocationType {
  AIRPORT
  HELIPORT
  CITY
  LANDING_SITE
}

/// Used by location charges now and by Aircraft from M3 step 3.
enum AircraftCategory {
  TURBOPROP
  LIGHT_JET
  MIDSIZE_JET
  HEAVY_JET
  HELICOPTER
  AIR_AMBULANCE_FIXED
  AIR_AMBULANCE_ROTARY
}

/// Airports, heliports and landing sites. Seeded from prisma/data (OurAirports)
/// and managed by operations. `capabilities` and `charges` shapes:
/// docs/architecture/database-design.md. The name and city trigram indexes
/// need the pg_trgm extension, created in the migration.
model Location {
  id           String       @id @default(uuid()) @db.Uuid
  type         LocationType
  name         String
  iata         String?      @unique @db.Char(3)
  icao         String?      @unique @db.Char(4)
  city         String?
  state        String?
  /// ISO 3166-1 alpha-2.
  country      String       @db.Char(2)
  latitude     Float
  longitude    Float
  /// IANA time zone, for example Asia/Kolkata.
  timeZone     String
  capabilities Json
  charges      Json?
  isActive     Boolean      @default(true)
  /// Where a seeded row came from, for example `ourairports:VABB`.
  externalRef  String?      @unique
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz

  homeBasedAircraft        Aircraft[]            @relation("AircraftHomeBase")
  currentlyHereAircraft    Aircraft[]            @relation("AircraftCurrentLocation")
  departureSlots           AvailabilitySlot[]
  emptyLegOrigins          EmptyLeg[]            @relation("EmptyLegOrigin")
  emptyLegDestinations     EmptyLeg[]            @relation("EmptyLegDestination")
  emptyLegPositions        EmptyLeg[]            @relation("EmptyLegCurrentLocation")
  airAmbulanceOrigins      AirAmbulanceRequest[] @relation("AirAmbulanceOrigin")
  airAmbulanceDestinations AirAmbulanceRequest[] @relation("AirAmbulanceDestination")

  @@index([type, isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_name_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_city_trgm_idx")
}

// ---------------------------------------------------------------------------
// M3. Aircraft
// ---------------------------------------------------------------------------

enum WingType {
  FIXED_WING
  HELICOPTER
}

enum AircraftAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

/// Values and transitions: docs/architecture/state-machines.md.
enum AircraftListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum AircraftPricingModel {
  HOURLY
  SECTOR
  FIXED_ROUTE
}

enum AircraftMediaKind {
  PHOTO
  FLOOR_PLAN
}

enum AircraftDocumentType {
  REGISTRATION
  AIRWORTHINESS
  INSURANCE
  OTHER
}

/// An aircraft profile belonging to one operator. Searchable only when
/// listingStatus is APPROVED, the operator is APPROVED, availabilityStatus is
/// AVAILABLE, and required documents are unexpired (enforced in search, M5).
model Aircraft {
  id                 String                     @id @default(uuid()) @db.Uuid
  operatorId         String                     @db.Uuid
  /// Tail number / registration mark, unique across the platform.
  registration       String                     @unique
  manufacturer       String
  model              String
  category           AircraftCategory
  wingType           WingType
  passengerCapacity  Int
  baggageCapacityKg  Int?
  rangeKm            Int?
  cruiseSpeedKmh     Int?
  homeBaseId         String?                    @db.Uuid
  currentLocationId  String?                    @db.Uuid
  operatingRegions   String[]                   @default([])
  /// Operating hours, excluded locations, minimum notice.
  restrictions       Json?
  availabilityStatus AircraftAvailabilityStatus @default(AVAILABLE)
  listingStatus      AircraftListingStatus      @default(DRAFT)
  pricingModel       AircraftPricingModel       @default(HOURLY)
  /// Free-form description and cabin notes.
  specifications     Json?
  medicalEquipment   Json?
  submittedAt        DateTime?                  @db.Timestamptz
  reviewedById       String?                    @db.Uuid
  reviewedAt         DateTime?                  @db.Timestamptz
  reviewNote         String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz
  updatedAt          DateTime                   @updatedAt @db.Timestamptz

  operator        Operator            @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  homeBase        Location?           @relation("AircraftHomeBase", fields: [homeBaseId], references: [id], onDelete: SetNull)
  currentLocation Location?           @relation("AircraftCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  media           AircraftMedia[]
  documents       AircraftDocument[]
  slots           AvailabilitySlot[]
  blocks          AvailabilityBlock[]
  bookings        Booking[]
  emptyLegs       EmptyLeg[]

  @@index([operatorId, listingStatus])
  @@index([listingStatus, category, passengerCapacity])
  @@index([homeBaseId])
  @@index([currentLocationId])
}

/// Photos and floor plans. The file lives in StoredFile (D-024); `kind`
/// must match the file's purpose.
model AircraftMedia {
  id         String            @id @default(uuid()) @db.Uuid
  aircraftId String            @db.Uuid
  fileId     String            @unique @db.Uuid
  kind       AircraftMediaKind
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now()) @db.Timestamptz
  updatedAt  DateTime          @updatedAt @db.Timestamptz

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId, sortOrder])
}

model AircraftDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  aircraftId         String                     @db.Uuid
  type               AircraftDocumentType
  fileId             String                     @unique @db.Uuid
  issuedAt           DateTime?                  @db.Date
  expiresAt          DateTime?                  @db.Date
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedById       String?                    @db.Uuid
  verifiedAt         DateTime?                  @db.Timestamptz
  verificationNote   String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz
  updatedAt          DateTime                   @updatedAt @db.Timestamptz

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId, type])
  @@index([expiresAt])
}

enum AvailabilitySlotKind {
  OPEN
  DEPARTURE_SLOT
}

enum AvailabilityBlockReason {
  MAINTENANCE
  BLACKOUT
  SOFT_HOLD
  BOOKING
  OTHER
}

/// Time the aircraft is offered.
model AvailabilitySlot {
  id         String               @id @default(uuid()) @db.Uuid
  aircraftId String               @db.Uuid
  startsAt   DateTime             @db.Timestamptz
  endsAt     DateTime             @db.Timestamptz
  originId   String?              @db.Uuid
  kind       AvailabilitySlotKind
  createdAt  DateTime             @default(now()) @db.Timestamptz
  updatedAt  DateTime             @updatedAt @db.Timestamptz

  aircraft Aircraft  @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  origin   Location? @relation(fields: [originId], references: [id], onDelete: SetNull)

  @@index([aircraftId, startsAt, endsAt])
  @@index([originId])
}

/// Time the aircraft is not free. Two BOOKING blocks for one aircraft may
/// never overlap; that exclusion constraint is raw SQL in the migration.
model AvailabilityBlock {
  id         String                  @id @default(uuid()) @db.Uuid
  aircraftId String                  @db.Uuid
  startsAt   DateTime                @db.Timestamptz
  endsAt     DateTime                @db.Timestamptz
  reason     AvailabilityBlockReason
  /// The booking this hold belongs to (M8). Set only by bookings.
  bookingId  String?                 @db.Uuid
  expiresAt  DateTime?               @db.Timestamptz
  note       String?
  createdAt  DateTime                @default(now()) @db.Timestamptz
  updatedAt  DateTime                @updatedAt @db.Timestamptz

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([aircraftId, startsAt, endsAt])
  @@index([reason, expiresAt])
  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// M7. Empty legs
// ---------------------------------------------------------------------------

/// Values and transitions: docs/architecture/state-machines.md.
enum EmptyLegStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  BOOKED
  WITHDRAWN
  EXPIRED
}

/// How the price was set. Only OPERATOR_PRICE is built (M7); its priceType is QUOTE.
enum EmptyLegPricingBasis {
  OPERATOR_PRICE
  PLATFORM_CALCULATED
}

/// An operator's one-way offer on an aircraft that would otherwise fly
/// empty. Listed only while PUBLISHED, before `expiresAt`, for an approved
/// operator and a bookable aircraft (rule 4, checked at read time).
model EmptyLeg {
  id                   String               @id @default(uuid()) @db.Uuid
  /// `FLY-EL-7K2M9Q` (common/reference.ts).
  reference            String               @unique
  aircraftId           String               @db.Uuid
  operatorId           String               @db.Uuid
  originId             String               @db.Uuid
  destinationId        String               @db.Uuid
  /// Not set by any route yet.
  currentLocationId    String?              @db.Uuid
  departureWindowStart DateTime             @db.Timestamptz
  departureWindowEnd   DateTime             @db.Timestamptz
  /// Seats offered.
  passengerCapacity    Int
  priceMinor           BigInt
  currency             String               @default("INR") @db.Char(3)
  pricingBasis         EmptyLegPricingBasis @default(OPERATOR_PRICE)
  /// The offer's validity: not bookable from this time.
  expiresAt            DateTime             @db.Timestamptz
  /// Not set by any route yet; `expiresAt` is the booking deadline.
  bookingDeadline      DateTime?            @db.Timestamptz
  /// Not set by any route yet; conditions are in `bookingConditions`.
  restrictions         Json?
  bookingConditions    String
  status               EmptyLegStatus       @default(DRAFT)
  submittedAt          DateTime?            @db.Timestamptz
  publishedAt          DateTime?            @db.Timestamptz
  reviewedById         String?              @db.Uuid
  reviewedAt           DateTime?            @db.Timestamptz
  /// The reason for the last rejection; cleared when submitted again.
  reviewNote           String?
  createdById          String               @db.Uuid
  createdAt            DateTime             @default(now()) @db.Timestamptz
  updatedAt            DateTime             @updatedAt @db.Timestamptz

  aircraft        Aircraft           @relation(fields: [aircraftId], references: [id], onDelete: Restrict)
  operator        Operator           @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  origin          Location           @relation("EmptyLegOrigin", fields: [originId], references: [id], onDelete: Restrict)
  destination     Location           @relation("EmptyLegDestination", fields: [destinationId], references: [id], onDelete: Restrict)
  currentLocation Location?          @relation("EmptyLegCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  interests       EmptyLegInterest[]

  @@index([status, expiresAt])
  @@index([originId, destinationId, departureWindowStart])
  @@index([operatorId, createdAt])
  @@index([aircraftId])
  @@index([destinationId])
  @@index([currentLocationId])
}

/// A customer asking to hear about changes to an offer.
model EmptyLegInterest {
  id         String    @id @default(uuid()) @db.Uuid
  emptyLegId String    @db.Uuid
  userId     String    @db.Uuid
  /// When the customer was last told of a change, withdrawal or expiry.
  notifiedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  emptyLeg EmptyLeg @relation(fields: [emptyLegId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([emptyLegId, userId])
  @@index([userId])
}

model ContentItem {
  id          String      @id @default(uuid()) @db.Uuid
  kind        ContentKind
  slug        String
  title       String
  body        String
  /// For policies: the version a Consent row records.
  version     String?
  region      String?
  sortOrder   Int         @default(0)
  publishedAt DateTime?   @db.Timestamptz
  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz

  @@unique([kind, slug])
  @@index([kind, publishedAt, sortOrder])
}

/// Every published version of a policy, kept for good (append-only). A
/// Consent records a version string; the text it names is never overwritten.
/// ContentItem holds the current one.
model PolicyVersion {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String
  version     String
  title       String
  body        String
  publishedAt DateTime @db.Timestamptz
  publishedBy String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@unique([slug, version])
}

// ---------------------------------------------------------------------------
// Service category configuration (C2): booking mode and payment model
// ---------------------------------------------------------------------------

/// Open decision 5. Air ambulance is never INSTANT (rule 7): enforced in
/// configuration/category-config.ts and by a CHECK constraint.
enum BookingMode {
  INSTANT
  REQUEST
}

/// Open decision 7: A full payment, B after operator confirmation, C deposit.
enum PaymentModel {
  A_INSTANT
  B_OPERATOR_CONFIRMED
  C_DEPOSIT
}

/// Platform setting per category and region. An operator's override lives in
/// Operator.bookingMode and Operator.paymentModel (jsonb per category).
model ServiceCategoryConfig {
  id             String          @id @default(uuid()) @db.Uuid
  category       ServiceCategory
  region         String          @default("IN")
  isEnabled      Boolean         @default(true)
  bookingMode    BookingMode
  paymentModel   PaymentModel
  /// The Model C deposit, in whole percent of the confirmed total (1 to 100,
  /// CHECK). Rounded up to the next paisa (payments/payment-amount.ts).
  depositPercent Int             @default(25)
  createdAt      DateTime        @default(now()) @db.Timestamptz
  updatedAt      DateTime        @updatedAt @db.Timestamptz

  @@unique([category, region])
}

// ---------------------------------------------------------------------------
// Sales enquiries (contact page)
// ---------------------------------------------------------------------------

/// What a sales enquiry from the contact page is about.
enum EnquiryTopic {
  GENERAL
  PRIVATE_CHARTER
  CELEBRITY_CHARTER
  ELECTION_CHARTER
  MARRIAGE_CHARTER
  PILGRIMAGE_CHARTER
  MEDICAL_CHARTER
  GROUP_CHARTER
  FLOWER_DROP_CHARTER
  AIRCRAFT_SALES
  CONSULTANCY
  PILOT_JOBS
  PILOT_TRAINING
}

/// A sales enquiry sent from the public contact page. Contact details and
/// the message are personal data: never logged, never in the audit trail.
model Enquiry {
  id        String       @id @default(uuid()) @db.Uuid
  /// Human reference, for example FLY-ENQ-7K2M9Q.
  reference String       @unique
  name      String
  email     String?
  phone     String?
  topic     EnquiryTopic
  message   String
  /// When operations dealt with it (set from the admin list, M10).
  handledAt DateTime?    @db.Timestamptz
  createdAt DateTime     @default(now()) @db.Timestamptz
  updatedAt DateTime     @updatedAt @db.Timestamptz

  @@index([handledAt, createdAt])
}

// ---------------------------------------------------------------------------
// M5. Search and pricing (docs/architecture/pricing-engine.md)
// ---------------------------------------------------------------------------

enum PricingRuleScope {
  PLATFORM
  CATEGORY
  OPERATOR
  AIRCRAFT
  ROUTE
}

enum PricingRuleType {
  HOURLY_RATE
  SECTOR_RATE
  FIXED_ROUTE
  MIN_BILLABLE_HOURS
  POSITIONING
  WAITING
  OVERNIGHT
  LANDING
  HANDLING
  CREW
  FUEL_SURCHARGE
  PERMIT
  NAVIGATION
  OTHER
  COMMISSION
  MARKUP
  SERVICE_FEE
  MIN_CHARGE
  TAX
  DISCOUNT
  ROUTING_FACTOR
  /// Minutes added to each leg for taxi, departure and arrival.
  TIME_ALLOWANCE
  VALIDITY
  /// Matching limits for all aircraft or one category: leg distance,
  /// runway, landing sites, notice. Not a price; read by matching.
  MATCHING_LIMITS
}

/// Every price carries one (business rule 1).
enum PriceType {
  ESTIMATE
  LIVE_FARE
  QUOTE
  CONFIRMED
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
  MULTI_LEG
}

/// A pricing input. Never edited in place: a change closes this row
/// (`validTo`, `isActive`) and creates the next `version`, so past
/// calculations stay explainable. `scopeRef` is the category, operator,
/// aircraft or route the rule belongs to; null for PLATFORM.
model PricingRule {
  id          String           @id @default(uuid()) @db.Uuid
  scope       PricingRuleScope
  scopeRef    String?
  type        PricingRuleType
  config      Json
  priority    Int              @default(0)
  validFrom   DateTime         @default(now()) @db.Timestamptz
  validTo     DateTime?        @db.Timestamptz
  isActive    Boolean          @default(true)
  version     Int              @default(1)
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz

  @@index([type, scope, scopeRef, isActive])
}

/// One customer search. Doubles as the search log for reporting. `results`
/// holds the offered aircraft in order; `exclusions` why the others were
/// left out (operations only).
model Search {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String?         @db.Uuid
  category       ServiceCategory
  tripType       TripType
  legs           Json
  passengerCount Int
  preferences    Json?
  results        Json
  exclusions     Json?
  resultCount    Int
  durationMs     Int
  providerStatus Json?
  createdAt      DateTime        @default(now()) @db.Timestamptz

  calculations PriceCalculation[]

  @@index([createdAt])
}

/// An engine-generated price with everything needed to explain it.
/// Immutable once written. `operatorPayableMinor` and
/// `platformRevenueMinor` are never shown to customers.
model PriceCalculation {
  id                    String    @id @default(uuid()) @db.Uuid
  searchId              String?   @db.Uuid
  aircraftId            String    @db.Uuid
  operatorId            String    @db.Uuid
  inputs                Json
  appliedRules          Json
  breakdown             Json
  baseMinor             BigInt
  feesMinor             BigInt
  taxMinor              BigInt
  discountMinor         BigInt
  totalMinor            BigInt
  operatorPayableMinor  BigInt
  platformRevenueMinor  BigInt
  currency              String    @db.Char(3)
  priceType             PriceType
  validUntil            DateTime  @db.Timestamptz
  availabilityCheckedAt DateTime  @db.Timestamptz
  assumptions           Json
  exclusions            Json
  warnings              Json
  overriddenById        String?   @db.Uuid
  overrideReason        String?
  createdAt             DateTime  @default(now()) @db.Timestamptz

  search   Search?   @relation(fields: [searchId], references: [id], onDelete: SetNull)
  quotes   Quote[]
  bookings Booking[]

  @@index([searchId])
  @@index([aircraftId, createdAt])
  @@index([operatorId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// M8. Quotes and bookings
// ---------------------------------------------------------------------------

/// Values and transitions: docs/architecture/state-machines.md (Booking).
enum BookingStatus {
  REQUESTED
  OPERATOR_PENDING
  CLARIFICATION_REQUESTED
  PRICE_CONFIRMED
  AWAITING_PAYMENT
  CONFIRMED
  SCHEDULED
  COMPLETED
  OPERATOR_UNAVAILABLE
  QUOTE_DECLINED
  EXPIRED
  CANCELLED
}

/// A summary of a booking's payments, derived from them (M9). Never the
/// booking status: a paid booking is not confirmed by payment alone (rule 2).
enum BookingPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUND_PENDING
  REFUNDED
}

/// Values and transitions: docs/architecture/state-machines.md (Quote).
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum BookingEventType {
  STATUS_CHANGED
  OPERATOR_RESPONSE
  QUOTE_ISSUED
  PAYMENT_UPDATE
  NOTE
  MESSAGE
  CHANGE_REQUESTED
  CANCELLATION_REQUESTED
}

enum ChangeRequestKind {
  CHANGE
  CANCELLATION
}

enum ChangeRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

/// An operator's (or operations') price for a booking request. Never edited
/// once sent: a revision is a new quote that supersedes the last. At most
/// one ACCEPTED quote per booking (partial unique index in the migration).
model Quote {
  id            String      @id @default(uuid()) @db.Uuid
  /// `FLY-QT-7K2M9Q` (common/reference.ts).
  reference     String      @unique
  /// Null until the quote is attached to a booking.
  bookingId     String?     @db.Uuid
  calculationId String?     @db.Uuid
  operatorId    String      @db.Uuid
  totalMinor    BigInt
  currency      String      @db.Char(3)
  /// QUOTE until accepted (rule 1).
  priceType     PriceType   @default(QUOTE)
  /// Price inclusions, exclusions and cancellation conditions (jsonb).
  conditions    Json
  validUntil    DateTime    @db.Timestamptz
  status        QuoteStatus @default(DRAFT)
  createdById   String?     @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @updatedAt @db.Timestamptz

  booking     Booking?          @relation("BookingQuotes", fields: [bookingId], references: [id], onDelete: Restrict)
  calculation PriceCalculation? @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  operator    Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  acceptedBy  Booking?          @relation("BookingAcceptedQuote")

  @@index([bookingId, status])
  @@index([operatorId, status])
  @@index([calculationId])
}

/// A booking. `bookingMode`, `paymentModel`, `priceType` and
/// `cancellationTerms` are snapshots taken when it is created and do not
/// follow later configuration changes. `status` and `paymentStatus` are
/// separate (rule 2); status changes go through the bookings transition
/// function, which writes a BookingEvent.
model Booking {
  id                 String               @id @default(uuid()) @db.Uuid
  /// `FLY-BK-7K2M9Q` (common/reference.ts).
  reference          String               @unique
  /// The customer's User account (ownership is checked against the session).
  customerId         String               @db.Uuid
  category           ServiceCategory
  status             BookingStatus        @default(REQUESTED)
  bookingMode        BookingMode
  paymentModel       PaymentModel
  /// Null for scheduled airline bookings.
  operatorId         String?              @db.Uuid
  aircraftId         String?              @db.Uuid
  /// No foreign key until EmptyLeg exists (M7).
  emptyLegId         String?              @db.Uuid
  /// Scheduled airline supplier and its booking reference.
  supplier           String?
  supplierReference  String?
  itinerary          Json
  calculationId      String?              @db.Uuid
  acceptedQuoteId    String?              @unique @db.Uuid
  totalMinor         BigInt
  currency           String               @db.Char(3)
  priceType          PriceType
  paymentStatus      BookingPaymentStatus @default(UNPAID)
  /// The cancellation conditions shown before the customer committed (rule 9).
  cancellationTerms  Json
  specialRequests    String?
  /// The operations owner.
  assignedToId       String?              @db.Uuid
  operatorAcceptedAt DateTime?            @db.Timestamptz
  confirmedAt        DateTime?            @db.Timestamptz
  cancelledAt        DateTime?            @db.Timestamptz
  cancellationReason String?
  createdAt          DateTime             @default(now()) @db.Timestamptz
  updatedAt          DateTime             @updatedAt @db.Timestamptz

  customer       User                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  operator       Operator?           @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  aircraft       Aircraft?           @relation(fields: [aircraftId], references: [id], onDelete: Restrict)
  calculation    PriceCalculation?   @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  acceptedQuote  Quote?              @relation("BookingAcceptedQuote", fields: [acceptedQuoteId], references: [id], onDelete: Restrict)
  quotes         Quote[]             @relation("BookingQuotes")
  passengers     BookingPassenger[]
  events         BookingEvent[]
  changeRequests ChangeRequest[]
  payments       Payment[]
  settlement     Settlement?
  holds          AvailabilityBlock[]

  @@index([customerId, createdAt])
  @@index([operatorId, status])
  @@index([status, createdAt])
  @@index([aircraftId])
  @@index([calculationId])
  @@index([assignedToId])
}

/// A traveller as they were when the booking was made. `documentNumber` and
/// `specialAssistance` hold FieldCipher ciphertext
/// (docs/architecture/security-rbac.md).
model BookingPassenger {
  id                String                @id @default(uuid()) @db.Uuid
  bookingId         String                @db.Uuid
  /// The saved passenger copied from, if any.
  passengerId       String?               @db.Uuid
  firstName         String
  lastName          String
  dateOfBirth       DateTime?             @db.Date
  gender            Gender                @default(UNSPECIFIED)
  nationality       String?               @db.Char(2)
  documentType      IdentityDocumentType?
  documentNumber    String?
  documentExpiry    DateTime?             @db.Date
  specialAssistance String?
  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @updatedAt @db.Timestamptz

  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  passenger Passenger? @relation(fields: [passengerId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([passengerId])
}

/// The booking timeline. Append-only: a trigger refuses every update, delete
/// and truncate, so `actorId` is deliberately not a foreign key.
model BookingEvent {
  id         String           @id @default(uuid()) @db.Uuid
  bookingId  String           @db.Uuid
  type       BookingEventType
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  actorId    String?          @db.Uuid
  actorRole  Role?
  payload    Json?
  createdAt  DateTime         @default(now()) @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
}

/// A customer's request to change or cancel a booking. At most one open
/// (REQUESTED) request per booking and kind (partial unique index).
model ChangeRequest {
  id          String              @id @default(uuid()) @db.Uuid
  bookingId   String              @db.Uuid
  kind        ChangeRequestKind
  details     String
  chargeMinor BigInt?
  refundMinor BigInt?
  currency    String              @db.Char(3)
  status      ChangeRequestStatus @default(REQUESTED)
  decidedById String?             @db.Uuid
  decidedAt   DateTime?           @db.Timestamptz
  createdAt   DateTime            @default(now()) @db.Timestamptz
  updatedAt   DateTime            @updatedAt @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@index([status, createdAt])
}

/// Values and transitions: docs/architecture/state-machines.md (Payment).
/// Separate from the booking status: a payment never confirms a booking by
/// itself (rule 2).
enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  /// The in-memory mock gateway (PAYMENT_PROVIDER=mock): never real money.
  MOCK
}

/// Why operations must look at a payment (M9). A late success, or a second
/// payment for an already-paid booking, is kept and refunded (W4-1).
enum PaymentReviewReason {
  /// Succeeded for a booking that had EXPIRED or been CANCELLED.
  BOOKING_CLOSED
  /// Succeeded although the booking was already paid by another payment.
  ALREADY_PAID
  /// The gateway reported another amount or currency than the order's.
  AMOUNT_MISMATCH
}

enum PaymentPurpose {
  FULL
  DEPOSIT
  BALANCE
}

enum RefundStatus {
  REQUESTED
  PENDING
  COMPLETED
  FAILED
}

enum SettlementStatus {
  NOT_DUE
  DUE
  PAID
  ON_HOLD
}

/// One attempt to pay for a booking through the gateway (M9). Holds provider
/// ids and the method type only: never card data (rule 10). The provider ids
/// are unique per provider, so a callback can never be applied to two rows.
model Payment {
  id                String               @id @default(uuid()) @db.Uuid
  reference         String               @unique
  bookingId         String               @db.Uuid
  provider          PaymentProvider
  providerOrderId   String?
  providerPaymentId String?
  purpose           PaymentPurpose
  amountMinor       BigInt
  currency          String               @db.Char(3)
  status            PaymentStatus        @default(INITIATED)
  /// The method type the gateway reports (`card`, `upi`, `netbanking`, ...).
  method            String?
  failureCode       String?
  /// From the `Idempotency-Key` of the request that created it (rule 5).
  idempotencyKey    String               @unique
  paidAt            DateTime?            @db.Timestamptz
  /// Set when a verified event needs operations (late success, double payment).
  reviewReason      PaymentReviewReason?
  createdAt         DateTime             @default(now()) @db.Timestamptz
  updatedAt         DateTime             @updatedAt @db.Timestamptz

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  events  PaymentEvent[]
  refunds Refund[]

  @@unique([provider, providerOrderId])
  @@unique([provider, providerPaymentId])
  @@index([bookingId, createdAt])
  @@index([status, createdAt])
  @@index([reviewReason, createdAt])
}

/// Every gateway webhook, stored once (rule 5): unique on the provider's
/// event id, so a duplicate callback is refused by the database. Append-only:
/// a trigger refuses update, delete and truncate, and the API role may only
/// insert. `processedAt` is therefore set when the row is written, in the
/// transaction that applies the event.
model PaymentEvent {
  id              String          @id @default(uuid()) @db.Uuid
  paymentId       String?         @db.Uuid
  provider        PaymentProvider
  providerEventId String
  type            String
  payload         Json
  signatureValid  Boolean
  processedAt     DateTime?       @db.Timestamptz
  createdAt       DateTime        @default(now()) @db.Timestamptz

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([paymentId, createdAt])
}

/// Money returned against a payment (M9).
model Refund {
  id               String          @id @default(uuid()) @db.Uuid
  reference        String          @unique
  paymentId        String          @db.Uuid
  provider         PaymentProvider
  amountMinor      BigInt
  currency         String          @db.Char(3)
  reason           String
  status           RefundStatus    @default(REQUESTED)
  providerRefundId String?
  /// Not a foreign key, like Quote.createdById.
  requestedById    String?         @db.Uuid
  idempotencyKey   String          @unique
  createdAt        DateTime        @default(now()) @db.Timestamptz
  updatedAt        DateTime        @updatedAt @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRefundId])
  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

/// What Flyviman owes an operator for one booking (M9, manual payout).
model Settlement {
  id               String           @id @default(uuid()) @db.Uuid
  bookingId        String           @unique @db.Uuid
  operatorId       String           @db.Uuid
  payableMinor     BigInt
  commissionMinor  BigInt
  taxMinor         BigInt
  currency         String           @db.Char(3)
  status           SettlementStatus @default(NOT_DUE)
  paidAt           DateTime?        @db.Timestamptz
  /// The bank transfer reference of a manual payout.
  paymentReference String?
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([operatorId, status])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// M11. Air ambulance (W3-5). Medical details sit in their own table so they
// can be restricted separately (docs/architecture/security-rbac.md).
// ---------------------------------------------------------------------------

/// docs/architecture/state-machines.md, "Air ambulance request".
enum AirAmbulanceStatus {
  SUBMITTED
  ASSIGNED
  SOURCING
  FEASIBILITY_CHECK
  QUOTED
  ACCEPTED
  CONFIRMED
  COMPLETED
  DECLINED
  CANCELLED
}

enum PatientMobility {
  /// Walks unaided.
  AMBULATORY
  /// Walks or sits with help (wheelchair, support).
  ASSISTED
  /// Cannot sit up for the flight.
  NON_AMBULATORY
}

/// A request for an air ambulance transfer. A request until operations and
/// the operator verify the mission: never confirmed automatically (rule 7).
/// Contact details are personal data, never logged or audited.
model AirAmbulanceRequest {
  id                    String             @id @default(uuid()) @db.Uuid
  /// `FLY-AA-7K2M9Q` (common/reference.ts).
  reference             String             @unique
  /// The customer who asked (ownership is checked against the session).
  requesterId           String             @db.Uuid
  contactName           String
  /// E.164.
  contactPhone          String
  contactEmail          String?
  emergencyContactName  String?
  emergencyContactPhone String?
  /// The nearest airport or helipad at each end.
  originLocationId      String             @db.Uuid
  destinationLocationId String             @db.Uuid
  /// Where the patient is collected, for example a hospital.
  pickupAddress         String?
  /// The receiving hospital or facility.
  destinationFacility   String?
  preferredAt           DateTime           @db.Timestamptz
  patientCount          Int                @default(1)
  /// People travelling with the patient (family, the requester's own escort).
  accompanyingPersons   Int                @default(0)
  status                AirAmbulanceStatus @default(SUBMITTED)
  /// The operations owner. No foreign key, like Booking.assignedToId.
  assignedToId          String?            @db.Uuid
  /// The approved operator operations chose when quoting (W4-5). Its
  /// administrators read the medical details only once ACCEPTED or later.
  selectedOperatorId    String?            @db.Uuid
  /// The quotation sent to the customer (priceType QUOTE, rule 1). Paise.
  quoteAmountMinor      Int?
  quoteCurrency         String?            @db.Char(3)
  /// Service and cancellation conditions shown before the customer accepts
  /// (rule 9).
  quoteConditions       String?
  quotedAt              DateTime?          @db.Timestamptz
  /// The feasibility checklist as last recorded (booleans only, never
  /// medical text); each recording is also a timeline entry. CONFIRMED needs
  /// every item checked (rule 7).
  feasibility           Json?
  confirmedAt           DateTime?          @db.Timestamptz
  completedAt           DateTime?          @db.Timestamptz
  /// When it was DECLINED or CANCELLED.
  closedAt              DateTime?          @db.Timestamptz
  createdAt             DateTime           @default(now()) @db.Timestamptz
  updatedAt             DateTime           @updatedAt @db.Timestamptz

  requester           User                       @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  originLocation      Location                   @relation("AirAmbulanceOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destinationLocation Location                   @relation("AirAmbulanceDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  selectedOperator    Operator?                  @relation(fields: [selectedOperatorId], references: [id], onDelete: Restrict)
  medical             AirAmbulanceMedical?
  events              AirAmbulanceRequestEvent[]
  documents           AirAmbulanceDocument[]

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@index([assignedToId])
  @@index([selectedOperatorId, status])
  @@index([originLocationId])
  @@index([destinationLocationId])
}

/// The patient's medical details, one to one with the request. Free-text
/// clinical fields hold FieldCipher ciphertext; the structured fields are
/// plain but just as restricted. Never logged, listed or audited.
model AirAmbulanceMedical {
  id                   String          @id @default(uuid()) @db.Uuid
  requestId            String          @unique @db.Uuid
  /// Encrypted. Diagnosis and current condition.
  patientCondition     String
  mobility             PatientMobility
  stretcherRequired    Boolean         @default(false)
  oxygenRequired       Boolean         @default(false)
  /// Encrypted. The medical crew needed aboard, for example an ICU doctor.
  medicalStaffRequired String?
  /// Encrypted. Equipment beyond a stretcher and oxygen.
  equipmentRequired    String?
  /// Encrypted.
  specialisedCare      String?
  /// Encrypted.
  notes                String?
  createdAt            DateTime        @default(now()) @db.Timestamptz
  updatedAt            DateTime        @updatedAt @db.Timestamptz

  request AirAmbulanceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
}

/// The request's status timeline. Append-only: a trigger refuses every
/// update, delete and truncate, so `actorId` is deliberately not a foreign
/// key. A CONFIRMED entry needs an operations or super administrator actor
/// (CHECK, rule 7).
model AirAmbulanceRequestEvent {
  id         String              @id @default(uuid()) @db.Uuid
  requestId  String              @db.Uuid
  fromStatus AirAmbulanceStatus?
  toStatus   AirAmbulanceStatus
  actorId    String?             @db.Uuid
  actorRole  Role?
  /// What the step recorded, never medical or personal data: the
  /// feasibility checklist (booleans), a quote's amount and operator, an
  /// assignee id (W4-5).
  payload    Json?
  createdAt  DateTime            @default(now()) @db.Timestamptz

  request AirAmbulanceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

/// A medical document attached to a request. The file itself is a
/// StoredFile in private storage; each file belongs to one request at most.
model AirAmbulanceDocument {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @db.Uuid
  fileId    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  request AirAmbulanceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  file    StoredFile          @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}
