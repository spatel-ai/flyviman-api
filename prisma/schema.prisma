// Flyviman database schema.
// Design and conventions: ../../docs/architecture/database-design.md
// This file holds the foundation models. Each milestone adds its own models
// through a migration (see the /db-migration skill).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OPERATOR_ADMIN
  OPERATOR_STAFF
  OPS
  FINANCE_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @db.Timestamptz
  phoneVerifiedAt DateTime?  @db.Timestamptz
  lastLoginAt     DateTime?  @db.Timestamptz
  createdAt       DateTime   @default(now()) @db.Timestamptz
  updatedAt       DateTime   @updatedAt @db.Timestamptz

  sessions        Session[]
  consents        Consent[]
  customerProfile CustomerProfile?
  operatorMember  OperatorMember?
  notifications   Notification[]
  storedFiles     StoredFile[]

  @@index([role, status])
}

/// One row per issued refresh token. Refresh tokens are stored hashed and rotate.
/// Every rotation of one sign-in shares a familyId; reuse of a rotated token
/// revokes the whole family.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime  @db.Timestamptz
  revokedAt        DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Append-only record of administrative and financial actions. `actorId` is
/// deliberately not a foreign key: a record must outlive the user it names
/// and can never be updated, not even to clear the reference.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actorRole  Role?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// M1. Identity
// ---------------------------------------------------------------------------

enum ConsentType {
  TERMS
  PRIVACY
  BOOKING_CONDITIONS
  MARKETING
}

/// One row per acceptance. `version` is the ContentItem.version accepted.
model Consent {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  type       ConsentType
  version    String
  acceptedAt DateTime    @default(now()) @db.Timestamptz
  ipAddress  String?
  createdAt  DateTime    @default(now()) @db.Timestamptz
  updatedAt  DateTime    @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model CustomerProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  firstName   String
  lastName    String
  dateOfBirth DateTime? @db.Date
  /// ISO 3166-1 alpha-2.
  nationality String?   @db.Char(2)
  preferences Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  passengers Passenger[]
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum IdentityDocumentType {
  PASSPORT
  AADHAAR
  DRIVING_LICENCE
  VOTER_ID
  OTHER
}

/// A traveller saved by a customer. `documentNumber` is encrypted by the
/// application (docs/architecture/security-rbac.md). Removal is a soft delete
/// because bookings will refer to passengers.
model Passenger {
  id                String                @id @default(uuid()) @db.Uuid
  customerId        String                @db.Uuid
  firstName         String
  lastName          String
  dateOfBirth       DateTime?             @db.Date
  gender            Gender                @default(UNSPECIFIED)
  nationality       String?               @db.Char(2)
  documentType      IdentityDocumentType?
  documentNumber    String?
  documentExpiry    DateTime?             @db.Date
  specialAssistance String?
  deletedAt         DateTime?             @db.Timestamptz
  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @updatedAt @db.Timestamptz

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, deletedAt])
}

// ---------------------------------------------------------------------------
// M1. Operators
// ---------------------------------------------------------------------------

enum ServiceCategory {
  SCHEDULED_AIRLINE
  PRIVATE_CHARTER
  HELICOPTER
  EMPTY_LEG
  AIR_AMBULANCE
}

/// Values and transitions: docs/architecture/state-machines.md.
enum OperatorStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model Operator {
  id                 String            @id @default(uuid()) @db.Uuid
  legalName          String
  tradingName        String?
  registrationNumber String?
  taxNumber          String?
  businessAddress    Json?
  billingAddress     Json?
  contactName        String
  contactEmail       String
  contactPhone       String?
  serviceCategories  ServiceCategory[]
  operatingRegions   String[]
  status             OperatorStatus    @default(DRAFT)
  submittedAt        DateTime?         @db.Timestamptz
  reviewedById       String?           @db.Uuid
  reviewedAt         DateTime?         @db.Timestamptz
  reviewNote         String?
  bookingMode        Json?
  paymentModel       Json?
  createdAt          DateTime          @default(now()) @db.Timestamptz
  updatedAt          DateTime          @updatedAt @db.Timestamptz

  members   OperatorMember[]
  documents OperatorDocument[]
  aircraft  Aircraft[]

  @@index([status, submittedAt])
}

/// Links an operator user to their organisation.
model OperatorMember {
  id          String   @id @default(uuid()) @db.Uuid
  operatorId  String   @db.Uuid
  userId      String   @unique @db.Uuid
  permissions Json?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

enum OperatorDocumentType {
  AOC
  INSURANCE
  REGISTRATION
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model OperatorDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  operatorId         String                     @db.Uuid
  type               OperatorDocumentType
  /// The uploaded file (documents module). Holds the storage key and name.
  fileId             String                     @unique @db.Uuid
  issuedAt           DateTime?                  @db.Date
  expiresAt          DateTime?                  @db.Date
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedById       String?                    @db.Uuid
  verifiedAt         DateTime?                  @db.Timestamptz
  verificationNote   String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz
  updatedAt          DateTime                   @updatedAt @db.Timestamptz

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, type])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// M1. Platform: files, notifications, content
// ---------------------------------------------------------------------------

enum FilePurpose {
  OPERATOR_DOCUMENT
  AIRCRAFT_PHOTO
  AIRCRAFT_FLOOR_PLAN
  AIRCRAFT_DOCUMENT
}

/// Metadata for a file in private storage. A file is usable once `uploadedAt`
/// is set, which happens when its owner attaches it to a record.
model StoredFile {
  id          String      @id @default(uuid()) @db.Uuid
  ownerId     String      @db.Uuid
  purpose     FilePurpose
  storageKey  String      @unique
  fileName    String
  contentType String
  sizeBytes   Int
  uploadedAt  DateTime?   @db.Timestamptz
  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

/// Delivery log and in-app inbox. `payload` never holds a one-time password,
/// a reset link or medical data.
model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  channel           NotificationChannel
  templateKey       String
  payload           Json
  status            NotificationStatus  @default(QUEUED)
  readAt            DateTime?           @db.Timestamptz
  providerMessageId String?
  createdAt         DateTime            @default(now()) @db.Timestamptz
  updatedAt         DateTime            @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, createdAt])
}

model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  key       String
  channel   NotificationChannel
  subject   String?
  body      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now()) @db.Timestamptz
  updatedAt DateTime            @updatedAt @db.Timestamptz

  @@unique([key, channel])
}

enum ContentKind {
  BANNER
  FAQ
  POLICY
}

// ---------------------------------------------------------------------------
// M3. Locations
// ---------------------------------------------------------------------------

enum LocationType {
  AIRPORT
  HELIPORT
  CITY
  LANDING_SITE
}

/// Used by location charges now and by Aircraft from M3 step 3.
enum AircraftCategory {
  TURBOPROP
  LIGHT_JET
  MIDSIZE_JET
  HEAVY_JET
  HELICOPTER
  AIR_AMBULANCE_FIXED
  AIR_AMBULANCE_ROTARY
}

/// Airports, heliports and landing sites. Seeded from prisma/data (OurAirports)
/// and managed by operations. `capabilities` and `charges` shapes:
/// docs/architecture/database-design.md. The name and city trigram indexes
/// need the pg_trgm extension, created in the migration.
model Location {
  id           String       @id @default(uuid()) @db.Uuid
  type         LocationType
  name         String
  iata         String?      @unique @db.Char(3)
  icao         String?      @unique @db.Char(4)
  city         String?
  state        String?
  /// ISO 3166-1 alpha-2.
  country      String       @db.Char(2)
  latitude     Float
  longitude    Float
  /// IANA time zone, for example Asia/Kolkata.
  timeZone     String
  capabilities Json
  charges      Json?
  isActive     Boolean      @default(true)
  /// Where a seeded row came from, for example `ourairports:VABB`.
  externalRef  String?      @unique
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz

  homeBasedAircraft     Aircraft[] @relation("AircraftHomeBase")
  currentlyHereAircraft Aircraft[] @relation("AircraftCurrentLocation")

  @@index([type, isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_name_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_city_trgm_idx")
}

// ---------------------------------------------------------------------------
// M3. Aircraft
// ---------------------------------------------------------------------------

enum WingType {
  FIXED_WING
  HELICOPTER
}

enum AircraftAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

/// Values and transitions: docs/architecture/state-machines.md.
enum AircraftListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum AircraftPricingModel {
  HOURLY
  SECTOR
  FIXED_ROUTE
}

enum AircraftMediaKind {
  PHOTO
  FLOOR_PLAN
}

enum AircraftDocumentType {
  REGISTRATION
  AIRWORTHINESS
  INSURANCE
  OTHER
}

/// An aircraft profile belonging to one operator. Searchable only when
/// listingStatus is APPROVED, the operator is APPROVED, availabilityStatus is
/// AVAILABLE, and required documents are unexpired (enforced in search, M4).
model Aircraft {
  id                 String                     @id @default(uuid()) @db.Uuid
  operatorId         String                     @db.Uuid
  /// Tail number / registration mark, unique across the platform.
  registration       String                     @unique
  manufacturer       String
  model              String
  category           AircraftCategory
  wingType           WingType
  passengerCapacity  Int
  baggageCapacityKg  Int?
  rangeKm            Int?
  cruiseSpeedKmh     Int?
  homeBaseId         String?                    @db.Uuid
  currentLocationId  String?                    @db.Uuid
  operatingRegions   String[]                   @default([])
  /// Operating hours, excluded locations, minimum notice.
  restrictions       Json?
  availabilityStatus AircraftAvailabilityStatus @default(AVAILABLE)
  listingStatus      AircraftListingStatus      @default(DRAFT)
  pricingModel       AircraftPricingModel       @default(HOURLY)
  /// Free-form description and cabin notes.
  specifications     Json?
  medicalEquipment   Json?
  submittedAt        DateTime?                  @db.Timestamptz
  reviewedById       String?                    @db.Uuid
  reviewedAt         DateTime?                  @db.Timestamptz
  reviewNote         String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz
  updatedAt          DateTime                   @updatedAt @db.Timestamptz

  operator        Operator           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  homeBase        Location?          @relation("AircraftHomeBase", fields: [homeBaseId], references: [id], onDelete: SetNull)
  currentLocation Location?          @relation("AircraftCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  media           AircraftMedia[]
  documents       AircraftDocument[]

  @@index([operatorId, listingStatus])
  @@index([listingStatus, category, passengerCapacity])
  @@index([homeBaseId])
  @@index([currentLocationId])
}

/// Photos and floor plans. The file lives in StoredFile (D-024); `kind`
/// must match the file's purpose.
model AircraftMedia {
  id         String            @id @default(uuid()) @db.Uuid
  aircraftId String            @db.Uuid
  fileId     String            @unique @db.Uuid
  kind       AircraftMediaKind
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now()) @db.Timestamptz
  updatedAt  DateTime          @updatedAt @db.Timestamptz

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId, sortOrder])
}

model AircraftDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  aircraftId         String                     @db.Uuid
  type               AircraftDocumentType
  fileId             String                     @unique @db.Uuid
  issuedAt           DateTime?                  @db.Date
  expiresAt          DateTime?                  @db.Date
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedById       String?                    @db.Uuid
  verifiedAt         DateTime?                  @db.Timestamptz
  verificationNote   String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz
  updatedAt          DateTime                   @updatedAt @db.Timestamptz

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId, type])
  @@index([expiresAt])
}

model ContentItem {
  id          String      @id @default(uuid()) @db.Uuid
  kind        ContentKind
  slug        String
  title       String
  body        String
  /// For policies: the version a Consent row records.
  version     String?
  region      String?
  sortOrder   Int         @default(0)
  publishedAt DateTime?   @db.Timestamptz
  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz

  @@unique([kind, slug])
  @@index([kind, publishedAt, sortOrder])
}
