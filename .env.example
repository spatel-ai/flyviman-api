# Copy to .env for local development. Never commit .env.
# Values below match docker-compose.yml and are for local use only.

# Required: development, test or production. Development tools (below) are
# only for a developer's own machine and automated tests.
NODE_ENV=development
PORT=4000
# The API connects as the restricted role flyviman_app, which cannot alter
# tables or change the audit trail. Migrations and the seed connect as the
# owner. With only DATABASE_URL set, everything uses it (and the API warns).
# A volume made before the role existed: docker compose exec -T postgres
#   psql -U flyviman -d flyviman < docker/postgres-init/10-app-role.sql
DATABASE_URL=postgresql://flyviman_app:flyviman_app@localhost:5432/flyviman?schema=public
MIGRATION_DATABASE_URL=postgresql://flyviman:flyviman@localhost:5432/flyviman?schema=public
# true: refuse to start (not only warn) when DATABASE_URL owns the tables or
# may delete audit records. Set on a host once it uses the restricted role.
# REQUIRE_RESTRICTED_DB_ROLE=false
WEB_ORIGIN=http://localhost:3000

# Redis: one-time codes, reset and invitation tokens, sign-in failure counts
REDIS_URL=redis://localhost:6379

# Signs access tokens. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# REFRESH_ROTATION_GRACE_SECONDS=10
# Successful refreshes one sign-in may make a minute; more answer 429.
# REFRESH_ROTATIONS_PER_MINUTE=30
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_PER_HOUR=5

# Encrypts sensitive columns and keys the idempotency request hash (HKDF).
# 32 random bytes, base64; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Development helpers: the messaging outbox route (GET /api/v1/dev/outbox),
# the local-disk storage mock and the seed's local accounts. Never in
# production; the API refuses to start with both set.
ENABLE_DEV_TOOLS=true

# Providers (D-064). With ENABLE_DEV_TOOLS=true locally, keep the defaults.
# A proof-of-concept host (e.g. Render) without real providers sets:
#   NODE_ENV=production, ENABLE_DEV_TOOLS=false,
#   MESSAGING_PROVIDER=sink  (messages discarded; no codes arrive),
#   STORAGE_PROVIDER=local   (files on this server's disk, lost on redeploy),
#   API_PUBLIC_URL=https://<this API's public address>
# MESSAGING_PROVIDER=mock
# STORAGE_PROVIDER=mock
# AIRLINE_PROVIDER=mock  (only value until a supplier is chosen)
# AIRLINE_TIMEOUT_MS=8000  (per supplier, per scheduled search; slower ones are reported as TIMEOUT)
# AIRLINE_OFFER_TTL_MINUTES=15  (how long scheduled fares and searches stay valid)

# Payments. The mock gateway (default, every test) moves no money; razorpay
# uses the Razorpay API. Payments must not go live until the commercial
# decisions are settled (docs/open-decisions.md, Hard gate). SETTLEMENT_MODE
# is manual (settlements recorded by hand); razorpay_route is reserved and
# refused until built.
# PAYMENT_PROVIDER=mock
# SETTLEMENT_MODE=manual
# The mock gateway's key secret and webhook secret. Required in production
# with the mock (each server its own, at least 16 characters, never the
# development values); unset elsewhere they default to the mock's
# development values, which the tests sign with. Never logged.
# PAYMENT_KEY_SECRET=mock-payment-key-secret
# PAYMENT_WEBHOOK_SECRET=mock-payment-webhook-secret
# Razorpay (PAYMENT_PROVIDER=razorpay): the API key from the Dashboard (key
# ID and secret required; the browser gets the key ID only) and the secret
# set with the webhook (optional: without it webhooks are refused and
# payments settle through the status sweep). Never commit real values.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Printed on payment receipts (not GST tax invoices, open decision 13).
# Only the name has a default; the others are left off the receipt when unset.
# RECEIPT_ISSUER_NAME=Flyviman
# RECEIPT_ISSUER_ADDRESS=
# RECEIPT_ISSUER_EMAIL=
# RECEIPT_ISSUER_PHONE=

# Local-disk storage (mock or local)
# STORAGE_DIR=.storage
# API_PUBLIC_URL=http://localhost:4000

# Parent domain shared by web and API in deployed environments, e.g. .flyviman.com
# COOKIE_DOMAIN=

# Shared with the web host when it proxies /api/v1 (hosted, D-065): it signs
# each visitor's address into x-flyviman-client-ip so rate limits and the
# sign-in lockout count visitors apart. Same value on both hosts, at least
# 32 characters (openssl rand -base64 48). Leave unset locally: the header
# is then ignored and callers are counted by their connection's address.
# WEB_PROXY_SECRET=

# Requests per minute per address
# RATE_LIMIT_AUTH_PER_MINUTE=5
# RATE_LIMIT_DEFAULT_PER_MINUTE=100
# Public search routes that price aircraft (POST /search/*, GET /search/calendar)
# RATE_LIMIT_SEARCH_PER_MINUTE=20
# Enquiries from the contact page, per address per window. Unset, the
# per-window count follows RATE_LIMIT_AUTH_PER_MINUTE.
# RATE_LIMIT_ENQUIRY_PER_WINDOW=5
# RATE_LIMIT_ENQUIRY_WINDOW_SECONDS=600
# Booking requests (POST /bookings), per customer per window
# RATE_LIMIT_BOOKING_PER_WINDOW=10
# RATE_LIMIT_BOOKING_WINDOW_SECONDS=600
# Payment gateway webhooks (POST /webhooks/payments/:provider), per address
# RATE_LIMIT_WEBHOOK_PER_MINUTE=120

# Operations inbox that new enquiries are emailed to. Set the real address
# on every deployed environment.
# OPERATIONS_INBOX_EMAIL=operations@flyviman.test

# Whether notifications also go over WhatsApp (mock messaging only until a
# provider and registered templates exist). On unless NODE_ENV=production,
# where it is off unless set to true.
# WHATSAPP_ENABLED=true

# Open booking requests (REQUESTED or OPERATOR_PENDING) one customer may
# have at once; each holds an aircraft while the operator answers.
# BOOKING_MAX_OPEN_PER_CUSTOMER=5

# Hours an operator has to answer a booking request: the aircraft's soft hold
# and an operator quote's default validity.
# BOOKING_HOLD_HOURS=48

# Days after the last change to a customer's bookings or air ambulance
# requests during which an erasure of their personal data is refused
# (disputes, chargebacks). 0 erases at once (data retention is undecided).
# ERASURE_HOLD_DAYS=0

# Whether empty-leg offers wait for operations' approval before they are
# listed (M7). Off by default.
# EMPTY_LEG_REVIEW_REQUIRED=false

# How long an idempotent request holds its Idempotency-Key before a repeat
# may take it over (seconds, 30 to 3600). Longer than the slowest provider call.
# IDEMPOTENCY_LOCK_SECONDS=300

# LOG_LEVEL=info

# Seed (npm run db:seed). The super administrator is always created.
# The local accounts are created when ENABLE_DEV_TOOLS=true (development and
# test), or anywhere with SEED_DEMO_ACCOUNTS=true: on a shared host give
# SEED_LOCAL_PASSWORD a long random value.
# SEED_DEMO_ACCOUNTS=false
SEED_ADMIN_EMAIL=admin@flyviman.test
SEED_ADMIN_PASSWORD=
SEED_LOCAL_PASSWORD=

# --- Added to env.validation.ts when the module that needs them is built ---

# M8: Razorpay (use test-mode keys outside production)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
