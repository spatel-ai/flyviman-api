# Copy to .env for local development. Never commit .env.
# Values below match docker-compose.yml and are for local use only.

# Required: development, test or production. Development tools (below) are
# only for a developer's own machine and automated tests.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://flyviman:flyviman@localhost:5432/flyviman?schema=public
WEB_ORIGIN=http://localhost:3000

# Redis: one-time codes, reset and invitation tokens, sign-in failure counts, idempotency keys
REDIS_URL=redis://localhost:6379

# Signs access tokens. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# REFRESH_ROTATION_GRACE_SECONDS=10
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_PER_HOUR=5

# Encrypts sensitive columns. 32 random bytes, base64; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Development helpers: the messaging outbox route (GET /api/v1/dev/outbox),
# the local-disk storage mock and the seed's local accounts. Never in
# production; the API refuses to start with both set.
ENABLE_DEV_TOOLS=true

# Providers (D-064). With ENABLE_DEV_TOOLS=true locally, keep the defaults.
# A proof-of-concept host (e.g. Render) without real providers sets:
#   NODE_ENV=production, ENABLE_DEV_TOOLS=false,
#   MESSAGING_PROVIDER=sink  (messages discarded; no codes arrive),
#   STORAGE_PROVIDER=local   (files on this server's disk, lost on redeploy),
#   API_PUBLIC_URL=https://<this API's public address>
# MESSAGING_PROVIDER=mock
# STORAGE_PROVIDER=mock

# Local-disk storage (mock or local)
# STORAGE_DIR=.storage
# API_PUBLIC_URL=http://localhost:4000

# Parent domain shared by web and API in deployed environments, e.g. .flyviman.com
# COOKIE_DOMAIN=

# Requests per minute per address
# RATE_LIMIT_AUTH_PER_MINUTE=5
# RATE_LIMIT_DEFAULT_PER_MINUTE=100

# LOG_LEVEL=info

# Seed (npm run db:seed). The super administrator is always created.
# The local accounts are created when ENABLE_DEV_TOOLS=true (development and
# test), or anywhere with SEED_DEMO_ACCOUNTS=true: on a shared host give
# SEED_LOCAL_PASSWORD a long random value.
# SEED_DEMO_ACCOUNTS=false
SEED_ADMIN_EMAIL=admin@flyviman.test
SEED_ADMIN_PASSWORD=
SEED_LOCAL_PASSWORD=

# --- Added to env.validation.ts when the module that needs them is built ---

# M8: Razorpay (use test-mode keys outside production)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
