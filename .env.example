# Copy to .env for local development. Never commit .env.
# Values below match docker-compose.yml and are for local use only.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://flyviman:flyviman@localhost:5432/flyviman?schema=public
WEB_ORIGIN=http://localhost:3000

# --- Added to env.validation.ts when the module that needs them is built ---

# M0: sessions, rate limiting, idempotency, queues
# REDIS_URL=redis://localhost:6379
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# M7: Razorpay (use test-mode keys outside production)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
